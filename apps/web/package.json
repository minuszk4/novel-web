{
  "name": "web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "format": "prettier --write \"src/**/*.{ts,html,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css}\" \"tools/security/**/*.mjs\" \"tools/e2e/**/*.mjs\" \"e2e/static-host-security.spec.ts\" \"e2e/full-stack-smoke.spec.ts\" playwright.config.ts playwright.static-host.config.ts playwright.full-stack.config.ts package.json",
    "test": "ng test",
    "check:security-sinks": "node tools/security/check-angular-html-sinks.mjs",
    "test:ci": "npm run check:security-sinks && node --test tools/security/check-angular-html-sinks.test.mjs && ng test --watch=false --isolate --coverage --reporters=default --reporters=junit --output-file=reports/junit.xml",
    "test:e2e": "playwright test",
    "test:full-stack": "node tools/e2e/run-full-stack-smoke.mjs",
    "test:host-container": "node tools/e2e/run-static-host-tests.mjs",
    "test:e2e:postgres": "playwright test --config=playwright.live-postgres.config.ts",
    "test:performance": "npm run build && playwright test --config=playwright.performance.config.ts",
    "test:reader-matrix": "npm run build && playwright test --config=playwright.reader-matrix.config.ts"
  },
  "private": true,
  "packageManager": "npm@12.0.2",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "firebase": "^13.4.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.0",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@vitest/coverage-v8": "4.1.12",
    "happy-dom": "^21.0.4",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  }
}
