# Local development only. Replace this value before starting PostgreSQL.
POSTGRES_DB=novelweb
POSTGRES_USER=novelweb
POSTGRES_PASSWORD=replace-with-a-local-only-password
POSTGRES_PORT=5432

DATABASE_URL=jdbc:postgresql://localhost:5432/novelweb
DATABASE_USERNAME=novelweb
DATABASE_PASSWORD=replace-with-a-local-only-password
DATABASE_POOL_MAX_SIZE=5

# Generate a unique random 32-byte Base64URL key before enabling Google sign-in.
GOOGLE_AUTH_RATE_LIMIT_HMAC_KEY=replace-with-a-random-32-byte-base64url-key
GOOGLE_AUTH_RATE_LIMIT_REFILL_INTERVAL=6s
# Optional comma-separated proxy IPs/CIDRs. Only configure exact ingress proxy networks.
GOOGLE_AUTH_TRUSTED_PROXIES=
# Public Google Web client ID for the current deployment environment.
GOOGLE_AUTH_WEB_CLIENT_ID=replace-with-google-web-client-id.apps.googleusercontent.com
# Exact authorized GIS redirect URI; production must use HTTPS.
GOOGLE_AUTH_CREDENTIAL_CALLBACK_URI=http://localhost:8080/api/v1/auth/google/credential
# Frontend origins used by CORS and the Google credential callback Origin check.
NOVEL_WEB_CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:8088

# Server-side opaque session limits.
NOVEL_SESSION_ABSOLUTE_TTL=30d
NOVEL_SESSION_IDLE_TTL=7d
NOVEL_SESSION_TOUCH_INTERVAL=5m
NOVEL_LOGOUT_ALL_CONFIRMATION_TTL=5m

# Generate a separate random 32-byte Base64URL key for session-bound CSRF tokens.
NOVEL_CSRF_HMAC_KEY=replace-with-a-random-32-byte-base64url-key

# Separate signing key for opaque, owner/filter-bound private-library cursors.
NOVEL_LIBRARY_CURSOR_HMAC_KEY=replace-with-a-different-random-32-byte-base64url-key

# Workspace invitations are disabled unless both feature switches are explicitly enabled.
# Keep the invitation signing key separate from every other HMAC key.
NOVEL_WORKSPACE_INVITATIONS_ENABLED=false
NOVEL_WORKSPACE_INVITATION_WORKER_ENABLED=false
NOVEL_WORKSPACE_INVITATION_SIGNING_KEY=
NOVEL_APP_BASE_URL=http://localhost:4200
NOVEL_MAIL_FROM=
NOVEL_WORKSPACE_INVITATION_TTL=7d
NOVEL_WORKSPACE_INVITATION_POLL_DELAY=PT15S
# Optional generic SMTP transport. Do not enable invitations until the selected mail sink/provider is ready.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true

# Public guest catalog remains disabled until rights, publication and edge controls are approved.
# A valid, independent 32-byte key is required before the catalog can report ready.
NOVEL_FEATURE_PUBLIC_CATALOG_ENABLED=false
NOVEL_PUBLIC_CATALOG_RATE_LIMIT_HMAC_KEY=replace-with-a-random-32-byte-base64url-key
# Leave blank for direct local access. Configure only exact ingress proxy IPs/CIDRs.
NOVEL_PUBLIC_CATALOG_TRUSTED_PROXIES=
NOVEL_PUBLIC_CATALOG_RATE_LIMIT_CAPACITY=60
NOVEL_PUBLIC_CATALOG_RATE_LIMIT_REFILL_INTERVAL=1s
NOVEL_PUBLIC_CATALOG_RATE_LIMIT_CLEANUP_DELAY=1h

# Per-account import staging limits; terminal/expired file reservations release after janitor cleanup.
NOVEL_IMPORT_MAX_ACTIVE_JOBS_PER_USER=5
NOVEL_IMPORT_MAX_ACTIVE_DECLARED_BYTES_PER_USER=104857600
NOVEL_IMPORT_CREATE_RATE_LIMIT_CAPACITY=10
NOVEL_IMPORT_CREATE_RATE_LIMIT_REFILL_INTERVAL=6s
NOVEL_IMPORT_UPLOAD_RATE_LIMIT_CAPACITY=5
NOVEL_IMPORT_UPLOAD_RATE_LIMIT_REFILL_INTERVAL=10s
NOVEL_IMPORT_RATE_LIMIT_RETENTION=24h

# Offline translation preview only. API and worker require postgres + translation-fake profiles;
# the worker/API switches are independently opt-in and never call an external provider.
NOVEL_TRANSLATION_FAKE_ENABLED=false
NOVEL_TRANSLATION_FAKE_API_ENABLED=false
NOVEL_TRANSLATION_FAKE_WORKER_ENABLED=false

# MoMo sandbox is opt-in. Credentials are intentionally not included in this template.
NOVEL_MOMO_TEST_ENABLED=false
NOVEL_FEATURE_COMMERCE_SANDBOX_ENABLED=false
NOVEL_MOMO_TEST_RECONCILIATION_ENABLED=false
NOVEL_MOMO_TEST_RECONCILIATION_POLL_DELAY=30s
NOVEL_MOMO_TEST_RECONCILIATION_BATCH_SIZE=5

# Whole-manuscript publication and scheduled release stay disabled until legal/policy approval.
NOVEL_PUBLICATION_RELEASE_ENABLED=false
NOVEL_PUBLICATION_SCHEDULER_API_ENABLED=false
NOVEL_PUBLICATION_SCHEDULER_WORKER_ENABLED=false
NOVEL_PUBLICATION_SCHEDULER_POLL_DELAY=15s

# External publication takedown purge is disabled until operator-owned HTTPS adapters are ready.
# List exactly the configured targets, for example CDN,SEARCH_INDEX. Never commit bearer tokens.
NOVEL_PUBLICATION_PURGE_WORKER_ENABLED=false
NOVEL_PUBLICATION_PURGE_REQUIRED_TARGETS=
NOVEL_PUBLICATION_PURGE_BATCH_SIZE=5
NOVEL_PUBLICATION_PURGE_POLL_DELAY=30s
NOVEL_PUBLICATION_PURGE_CDN_ENDPOINT=
NOVEL_PUBLICATION_PURGE_CDN_TOKEN=
NOVEL_PUBLICATION_PURGE_SEARCH_INDEX_ENDPOINT=
NOVEL_PUBLICATION_PURGE_SEARCH_INDEX_TOKEN=
NOVEL_PUBLICATION_PURGE_FEED_CACHE_ENDPOINT=
NOVEL_PUBLICATION_PURGE_FEED_CACHE_TOKEN=
NOVEL_PUBLICATION_PURGE_SIGNED_LINKS_ENDPOINT=
NOVEL_PUBLICATION_PURGE_SIGNED_LINKS_TOKEN=

# Add legal-approved Terms and Privacy Notice versions through the versioned
# policy document migration only after the final documents and effective dates are approved.
